# Copy to .env and fill in what you use. Empty optional values switch the
# matching feature off. Never commit the filled-in file.

# LLM keys hermes can fall back to (the default model is set in hermes/config.yaml)
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Telegram gateway (token from BotFather; allowed users = comma-separated numeric IDs)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Voice transcription (optional)
GROQ_API_KEY=

# TickTick (static API token: web app → Settings → Account → API Token; shown once)
TICKTICK_API_TOKEN=

# Vaultwarden (credential vault for logins). Admin token is a random string:
# openssl rand -base64 48. The master password is the vault account's that
# login-broker unlocks.
VAULTWARDEN_ADMIN_TOKEN=
BW_MASTER_PASSWORD=

# Hindsight memory: the database password (any random string) and the key of
# the LLM the memory extractor uses.
HINDSIGHT_DB_PASSWORD=
HINDSIGHT_LLM_API_KEY=

# Zen-Money (budget). User token from the app: Настройки → «Доступ по токену».
# Optional — the zenmoney CLI refuses to work until it is set.
ZENMONEY_TOKEN=

# Gmail (gmail-mcp). CLIENT_ID/SECRET from a Google Cloud OAuth desktop client;
# REFRESH_TOKEN from the login flow in gmail_mcp.auth, run on your own
# machine, not on the server.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Telegram user account (telegram-mcp). API_ID/HASH from my.telegram.org →
# API development tools; SESSION_STRING from upstream's
# `uv run session_string_generator.py --qr`, run on your own machine.
# EXPECTED_USERNAME is the account's @username without the @.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
TELEGRAM_EXPECTED_USERNAME=

# Alice (Yandex) voice skill → alice-bridge (optional; all empty keeps it off)
ALICE_PATH_SECRET=
ALICE_WEBHOOK_SECRET=
ALICE_SKILL_ID=
ALICE_ALLOWED_USER_IDS=
# Spoken replies on a Yandex Station (optional; empty: answers go to Telegram only).
# YANDEX_X_TOKEN is a credential for the whole Yandex account the Station
# belongs to; one way to get it is the QR login of AlexxIT/YandexStation.
YANDEX_X_TOKEN=
# Alice application_id of each Station -> its Quasar device id: "app=device,...".
# alice-bridge logs unmapped ids at INFO, which is how a Station is mapped.
ALICE_STATIONS=
